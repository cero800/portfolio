FOOTBALL_API_KEY=

# ── Proyectos (GitHub API) ────────────────────────────────────────
# Token OPCIONAL para subir el límite de peticiones de 60 a 5.000 req/h
# durante el build. Classic token sin scopes (solo lectura pública):
# https://github.com/settings/tokens
# Sin token igual funciona: los repos destacados son pocos.
GITHUB_TOKEN=

# ── Envío del formulario de contacto ──────────────────────────────
# Copia este archivo a `.env` (desarrollo) o configura las variables
# en Vercel → Settings → Environment Variables (producción).

# Clave de API de Resend: https://resend.com → API Keys
RESEND_API_KEY=

# Dirección "De:" del correo que te llega del formulario.
# - Sin dominio propio: usa `Onboarding <onboarding@resend.dev>`.
#   OJO: Resend solo envía a tu propio email (el de tu cuenta) en este modo.
# - Con dominio verificado en Resend (recomendado para producción):
#   `CERO <portfolio@tudominio.com>`
RESEND_FROM=Onboarding <onboarding@resend.dev>

# Tu correo real donde quieres recibir los mensajes del formulario.
# En modo `onboarding@resend.dev` DEBE ser el email de tu cuenta de Resend.
RESEND_EMAIL_TO=