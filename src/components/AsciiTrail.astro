---
// Rastro de caracteres ASCII que sigue al puntero.
// Se dibuja en un canvas fijo por detrás del contenido (main usa z-10) y no
// captura eventos (pointer-events: none). Se desactiva en táctil y con
// preferencia de movimiento reducido.
---

<canvas id="ascii-trail" aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 h-full w-full"></canvas>

<script>
  interface Particle {
    x: number
    y: number
    vx: number
    vy: number
    char: string
    life: number
    decay: number
    size: number
    tone: string
  }

  const canvas = document.getElementById('ascii-trail') as HTMLCanvasElement | null
  const ctx = canvas?.getContext('2d') ?? null
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const coarsePointer = window.matchMedia('(pointer: coarse)').matches

  if (canvas && ctx && !reduceMotion && !coarsePointer) {
    const CHARS = '01<>[]{}/\\|=+*#$%&@:~;.,^`'.split('')
    const TONES = ['#45f585', '#34d36d', '#7dffb0', '#1e5631']
    const MAX_PARTICLES = 110
    const MIN_STEP = 9

    const particles: Particle[] = []
    let lastX = Number.NEGATIVE_INFINITY
    let lastY = Number.NEGATIVE_INFINITY
    let rafId = 0
    let lastFrame = 0

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      canvas.width = Math.floor(window.innerWidth * dpr)
      canvas.height = Math.floor(window.innerHeight * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }

    const frame = (now: number) => {
      const dt = Math.min(now - lastFrame || 16, 48)
      lastFrame = now

      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight)
      ctx.textAlign = 'center'
      ctx.textBaseline = 'middle'

      for (let i = particles.length - 1; i >= 0; i -= 1) {
        const p = particles[i]
        p.life -= p.decay * dt
        if (p.life <= 0) {
          particles.splice(i, 1)
          continue
        }

        const step = dt / 16.666
        p.x += p.vx * step
        p.y += p.vy * step
        p.vx *= 0.985
        p.vy = p.vy * 0.985 + 0.012

        ctx.globalAlpha = p.life * p.life
        ctx.fillStyle = p.tone
        ctx.shadowColor = p.tone
        ctx.shadowBlur = 6
        ctx.font = `${p.size}px "Fira Code", monospace`
        ctx.fillText(p.char, p.x, p.y)
      }

      ctx.globalAlpha = 1
      ctx.shadowBlur = 0

      rafId = particles.length > 0 ? window.requestAnimationFrame(frame) : 0
    }

    const start = () => {
      if (rafId) return
      lastFrame = performance.now()
      rafId = window.requestAnimationFrame(frame)
    }

    const spawn = (x: number, y: number, burst = false) => {
      const count = burst ? 10 : 1
      for (let i = 0; i < count; i += 1) {
        if (particles.length >= MAX_PARTICLES) particles.shift()

        const angle = Math.random() * Math.PI * 2
        const speed = burst ? 0.8 + Math.random() * 1.8 : 0.12 + Math.random() * 0.45

        particles.push({
          x: x + (Math.random() - 0.5) * 10,
          y: y + (Math.random() - 0.5) * 10,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          char: CHARS[(Math.random() * CHARS.length) | 0],
          life: 1,
          decay: 1 / (burst ? 900 + Math.random() * 500 : 550 + Math.random() * 450),
          size: burst ? 13 + Math.random() * 7 : 10 + Math.random() * 6,
          tone: TONES[(Math.random() * TONES.length) | 0],
        })
      }
      start()
    }

    const onPointerMove = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return
      const dx = event.clientX - lastX
      const dy = event.clientY - lastY
      if (Math.hypot(dx, dy) < MIN_STEP) return
      lastX = event.clientX
      lastY = event.clientY
      spawn(event.clientX, event.clientY)
    }

    const onPointerDown = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return
      spawn(event.clientX, event.clientY, true)
    }

    const onVisibility = () => {
      if (document.hidden) {
        window.cancelAnimationFrame(rafId)
        rafId = 0
      } else if (particles.length > 0) {
        start()
      }
    }

    resize()
    window.addEventListener('resize', resize, { passive: true })
    window.addEventListener('pointermove', onPointerMove, { passive: true })
    window.addEventListener('pointerdown', onPointerDown, { passive: true })
    document.addEventListener('visibilitychange', onVisibility)
  }
</script>
