---
// Ráfaga ASCII al éxito del formulario
---

<canvas id="ascii-confetti" aria-hidden="true" class="pointer-events-none fixed inset-0 z-[100] h-full w-full"></canvas>

<script>
  const canvas = document.getElementById('ascii-confetti') as HTMLCanvasElement | null
  const ctx = canvas?.getContext('2d') ?? null
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (canvas && ctx && !reduceMotion) {
    const CHARS = '><[]{}()#%$+*|/\\01'.split('')
    const TONES = ['#45f585', '#34d36d', '#7dffb0']
    const particles: Array<{
      x: number
      y: number
      vx: number
      vy: number
      char: string
      life: number
      decay: number
      size: number
      tone: string
      rot: number
      rvel: number
    }> = []

    let rafId = 0
    let lastFrame = 0

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      canvas.width = Math.floor(window.innerWidth * dpr)
      canvas.height = Math.floor(window.innerHeight * dpr)
      canvas.style.width = `${window.innerWidth}px`
      canvas.style.height = `${window.innerHeight}px`
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }

    const burst = (x: number, y: number) => {
      for (let i = 0; i < 40; i += 1) {
        const angle = Math.random() * Math.PI * 2
        const speed = 2.5 + Math.random() * 5
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 2,
          char: CHARS[(Math.random() * CHARS.length) | 0],
          life: 1,
          decay: 1 / (900 + Math.random() * 400),
          size: 12 + Math.random() * 8,
          tone: TONES[(Math.random() * TONES.length) | 0],
          rot: Math.random() * Math.PI * 2,
          rvel: (Math.random() - 0.5) * 0.4,
        })
      }
      if (!rafId) {
        lastFrame = performance.now()
        rafId = window.requestAnimationFrame(frame)
      }
    }

    const frame = (now: number) => {
      const dt = Math.min(now - lastFrame || 16, 48)
      lastFrame = now
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight)
      ctx.textAlign = 'center'
      ctx.textBaseline = 'middle'

      for (let i = particles.length - 1; i >= 0; i -= 1) {
        const p = particles[i]
        p.life -= p.decay * dt
        if (p.life <= 0) {
          particles.splice(i, 1)
          continue
        }
        const step = dt / 16.666
        p.x += p.vx * step
        p.y += p.vy * step
        p.vx *= 0.99
        p.vy = p.vy * 0.99 + 0.18
        p.rot += p.rvel * step

        ctx.save()
        ctx.translate(p.x, p.y)
        ctx.rotate(p.rot)
        ctx.globalAlpha = p.life * p.life
        ctx.fillStyle = p.tone
        ctx.shadowColor = p.tone
        ctx.shadowBlur = 10
        ctx.font = `${p.size}px "Fira Code", monospace`
        ctx.fillText(p.char, 0, 0)
        ctx.restore()
      }

      ctx.globalAlpha = 1
      ctx.shadowBlur = 0

      rafId = particles.length > 0 ? window.requestAnimationFrame(frame) : 0
    }

    resize()
    window.addEventListener('resize', resize, { passive: true })
    window.addEventListener('ascii-burst', ((e: CustomEvent) => {
      burst(e.detail?.x ?? window.innerWidth / 2, e.detail?.y ?? window.innerHeight / 2)
    }) as EventListener)
  }
</script>
