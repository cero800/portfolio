---
import '../styles/main.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import AsciiTrail from '../components/AsciiTrail.astro'
import BootSequence from '../components/BootSequence.astro'
import AsciiBackground from '../components/AsciiBackground.astro'
import ConfettiBurst from '../components/ConfettiBurst.astro'
import ViewTransitions from '../components/ViewTransitions.astro'
import type { Locale } from '../i18n/types'

const SITE_URL = 'https://mini-portfolio-sigma-33.vercel.app'
const {
  lang = 'es' as Locale,
  title = 'CERO · Backend & Web Developer',
  description = 'Portafolio de CERO (cero800): desarrollador backend que construye arquitectura sólida y experiencias web con estética TUI terminal.',
} = Astro.props

const slashless = SITE_URL.replace(/\/$/, '')
const canonical = lang === 'en' ? `${slashless}/en` : slashless
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES'
const alternateEs = slashless
const alternateEn = `${slashless}/en`

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'CERO',
      alternateName: 'cero800',
      url: canonical,
      sameAs: ['https://github.com/cero800'],
      jobTitle: 'Backend & Web Developer',
      knowsAbout: [
        'Go',
        'TypeScript',
        'JavaScript',
        'Python',
        'React',
        'Astro',
        'Node.js',
        'MySQL',
        'PostgreSQL',
        'Linux',
      ],
    },
    {
      '@type': 'WebSite',
      name: 'CERO Portfolio',
      url: canonical,
      inLanguage: lang,
    },
  ],
}
const structuredJson = JSON.stringify(structuredData).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a08" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CERO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${slashless}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${slashless}/og.png`} />

    <script type="application/ld+json" is:inline set:html={structuredJson} />
  </head>
  <body class="bg-[var(--bg)] text-[var(--textPrimary)]">
    <BootSequence />
    <AsciiBackground />
    <AsciiTrail />
    <ConfettiBurst />
    <ViewTransitions />
    <Navbar {lang} />
    <main class="relative z-10">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal suave de las secciones al entrar en viewport (Web Animations).
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const sections = Array.from(document.querySelectorAll<HTMLElement>('.section')).slice(1)
        if (sections.length > 0) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue
                const el = entry.target as HTMLElement
                el.animate(
                  [
                    { opacity: 0, transform: 'translateY(18px)' },
                    { opacity: 1, transform: 'translateY(0)' },
                  ],
                  { duration: 520, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)', fill: 'both' },
                )
                observer.unobserve(el)
              }
            },
            { threshold: 0.2 },
          )
          for (const section of sections) observer.observe(section)
        }
      }

      // Botones magnéticos sutiles
      if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
        const magnets = document.querySelectorAll<HTMLElement>('.magnetic')
        for (const el of magnets) {
          const strength = 12
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect()
            const x = e.clientX - rect.left - rect.width / 2
            const y = e.clientY - rect.top - rect.height / 2
            el.style.transform = `translate(${(x / rect.width) * strength}px, ${(y / rect.height) * strength}px)`
          })
          el.addEventListener('mouseleave', () => {
            el.style.transform = 'translate(0, 0)'
          })
        }

        // Tilt 3D en tarjeta de proyecto
        const tiltEl = document.querySelector<HTMLElement>('.project-tilt')
        if (tiltEl) {
          tiltEl.addEventListener('mousemove', (e) => {
            const rect = tiltEl.getBoundingClientRect()
            const x = (e.clientX - rect.left) / rect.width - 0.5
            const y = (e.clientY - rect.top) / rect.height - 0.5
            tiltEl.style.transform = `perspective(900px) rotateY(${x * 4}deg) rotateX(${-y * 4}deg)`
          })
          tiltEl.addEventListener('mouseleave', () => {
            tiltEl.style.transform = 'perspective(900px) rotateY(0deg) rotateX(0deg)'
          })
        }
      }
    </script>
  </body>
</html>
