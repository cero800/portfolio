---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Home from '../../components/Home.astro'
import { en } from '../../i18n/en'

const lang = 'en'

// Página estática: los datos de GitHub se obtienen una vez durante el build.
export const prerender = true
---

<BaseLayout {lang} title={en.baseTitle} description={en.description}>
  <Home {lang} dict={en} />
</BaseLayout>
